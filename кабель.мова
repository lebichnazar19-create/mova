# Переріз мідного кабелю за струмом

хай струм = число(питай("Струм, А: "))

якщо струм <= 16
    хай переріз = 1.5
інакше якщо струм <= 25
    хай переріз = 2.5
інакше якщо струм <= 32
    хай переріз = 4
інакше якщо струм <= 40
    хай переріз = 6
інакше якщо струм <= 50
    хай переріз = 10
інакше якщо струм <= 75
    хай переріз = 16
інакше
    хай переріз = 0

якщо переріз == 0
    друкуй("Понад 75 А — рахуй окремо")
    вібруй(500)
інакше
    друкуй("Мідь, мінімум", переріз, "мм2")
    вібруй(200)
