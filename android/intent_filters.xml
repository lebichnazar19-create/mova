<!-- Вставляється в <activity> головної активності (buildozer:
     android.manifest.intent_filters). Android пропонує застосунок при
     підключенні USB-плати з device_filter.xml і дає йому дозвіл на пристрій. -->
<intent-filter>
    <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
</intent-filter>
<meta-data android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
           android:resource="@xml/device_filter" />
