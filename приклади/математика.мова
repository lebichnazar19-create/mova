# Математика, рядки, час і файли — нові вбудовані дії (версія 0.7)
# Запуск: python3 мова.py --без-пристрою приклади/математика.мова

# Математика: корінь, степінь, округлення, модуль, мінімум/максимум
друкуй("корінь з 2 =", округли(корінь(2), 3), " 2^10 =", степінь(2, 10))
друкуй("модуль(-7) =", модуль(-7), " округли(2.5) =", округли(2.5), " округли(3.14159, 2) =", округли(3.14159, 2))
хай оцінки = [7, 12, 9, 11]
друкуй("мінімум:", мінімум(оцінки), " максимум:", максимум(оцінки), " максимум(3, 8, 5) =", максимум(3, 8, 5))

# Геометрія: стала ПІ і тригонометрія (кути в радіанах)
хай радіус = 5
друкуй("площа кола r=5:", округли(ПІ * степінь(радіус, 2), 2))
хай кут = ПІ / 6
друкуй("синус 30° =", округли(синус(кут), 2), " косинус 30° =", округли(косинус(кут), 3), " тангенс 45° =", округли(тангенс(ПІ / 4), 3))
друкуй("кут вектора (1, 1) у градусах:", округли(арктангенс2(1, 1) * 180 / ПІ))

# Випадкове: кидаємо кубик, поки не випаде шістка (не більше 100 разів)
хай кидків = 0
поки кидків < 100
    кидків = кидків + 1
    якщо випадкове(1, 6) == 6
        перервись
друкуй("шістка випала з", кидків, "спроби")

# Рядки: розбити, з'єднати, замінити, регістр, обрізати, перевірки
хай речення = "  Мова — це просто, і це весело  "
хай чисте = обріж(речення)
хай слова = розбий(чисте)
друкуй(слова, "— слів:", довжина(слова))
друкуй(з'єднай(слова, "_"))
друкуй(заміни(чисте, "просто", "цікаво"))
друкуй(великими("тихо"), малими("ГОЛОСНО"))
друкуй(починається(чисте, "Мова"), містить(чисте, "весело"), містить(слова, "це"))
хай частини = розбий("12:30:05", ":")
друкуй("годин:", число(частини[0]), " хвилин:", число(частини[1]))

# Перетворення: число / текст / дробове
хай введено = "8"
друкуй(число(введено) * 250, текст(250) + " грн", дробове("7,5") + 0.5)

# Час: дата, година, і вимір тривалості секундами
друкуй("зараз:", зараз(), " сьогодні:", сьогодні())
якщо година() < 12
    друкуй("Доброго ранку!")
інакше
    друкуй("Доброго дня! Хвилина зараз:", хвилина())
хай старт = секунди()
хай сума = 0
для i у діапазон(100000)
    сума = сума + i
друкуй("сума 0..99999 =", сума, " за", округли(секунди() - старт, 3), "с")

# Файли: список рядків, вміст теки, видалення
запиши_файл("математика_тест.txt", "перший\nдругий\nтретій\n")
для рядок у рядки_файлу("математика_тест.txt")
    друкуй("рядок:", рядок)
друкуй("є в теці:", містить(файли_в_теці("."), "математика_тест.txt"))
видали_файл("математика_тест.txt")
друкуй("після видалення:", є_файл("математика_тест.txt"))

# Помилки нових дій ловляться як і решта
спробуй
    друкуй(корінь(-9))
якщо помилка
    друкуй("Перехопили:", помилка)
