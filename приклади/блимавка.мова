# Пульт для плати (версія 1.3): блимання світлодіодом на піні 2.
# На платі має бути агент з agent/ (Arduino — UART, ESP32 — UART + Wi-Fi).
# У застосунку: підключи плату кабелем (OTG) або до її Wi-Fi і натисни
# «Плата», щоб побачити список. Без плати: python3 мова.py --без-пристрою
# приклади/блимавка.мова — тоді працює симуляція (світлодіод у пам'яті).

підключись("USB")
пін(2, вихід)
поки істина
  пиши(2, 1)
  зачекай(500)
  пиши(2, 0)
  зачекай(500)
