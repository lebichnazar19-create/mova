# Урок 8: списки — індекс, зміна елемента, додавання нового.

хай кошик = ["хліб", "молоко"]
друкуй("Кошик:", кошик)

кошик[1] = "сир"                # замінили другий елемент (індекс 1)
друкуй("Замінили:", кошик)

кошик = кошик + ["яблука"]      # додали новий елемент у кінець
друкуй("Додали:", кошик)
друкуй("Всього товарів:", довжина(кошик))
