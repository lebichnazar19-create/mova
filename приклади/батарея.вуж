# Показує стан батареї пристрою через termux-battery-status.

хай інфо = батарея()
хай заряд = інфо["percentage"]
хай стан = інфо["status"]

друкуй("Заряд:", заряд, "%")
друкуй("Стан:", стан)

якщо заряд < 20
    друкуй("Батарея майже розряджена!")
інакше якщо заряд < 50
    друкуй("Заряд середній.")
інакше
    друкуй("Заряд у нормі.")
