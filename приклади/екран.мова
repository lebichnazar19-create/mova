# Бібліотека «екран» (1.5): малювання на полотні застосунку в пікселях.
# Запуск: python3 мова.py --без-пристрою приклади/екран.мова
# Без застосунку (комп'ютер, редактор) — симуляція: нічого не показується,
# але й не падає. Побачити малюнок: «Зробити застосунок» з цієї програми —
# у ньому полотно (кнопка «Креслення») показує кожен онови().
# Старий приклад малювання в терміналі — приклади/термінал.мова.

підключи("екран")

хай ш = ширина()
хай в = висота()
друкуй("Полотно:", ш, "на", в, "пікселів")

# Розкреслена сітка: світло-сірі лінії кожні КРОК пікселів
стала КРОК = 40
колір(220, 220, 220)
хай x = 0
поки x <= ш
    лінія(x, 0, x, в)
    x = x + КРОК
хай y = 0
поки y <= в
    лінія(0, y, ш, y)
    y = y + КРОК

# Осі через середину — темніші
колір(150, 150, 150)
лінія(0, в / 2, ш, в / 2)
лінія(ш / 2, 0, ш / 2, в)

# Фігури: колір задається перед малюванням і діє далі
колір("синій")
заливка(КРОК, КРОК, 3 * КРОК, 2 * КРОК)

колір(229, 57, 53)
круг(ш - 2 * КРОК, 3 * КРОК, КРОК)

колір("зелений")
прямокутник(КРОК, в - 4 * КРОК, 4 * КРОК, 2 * КРОК)
коло(ш / 2, в / 2, 2 * КРОК)

колір(0, 0, 0)
лінія(0, в, ш, 0)

# Пунктир із крапок уздовж верхнього краю
хай і_ = 0
поки і_ < ш
    крапка(і_, 4)
    і_ = і_ + 4

онови()
друкуй("Готово: сітка", ш / КРОК, "на", в / КРОК, "клітинок і 6 фігур")
