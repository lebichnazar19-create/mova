# Геометрія на площині (версія 0.8): кімната 4×3 м, розетки на стінах,
# довжина кабелю від щитка до кожної — по стінах (не навпростець).
# Запуск: python3 мова.py --без-пристрою приклади/геометрія.мова

# Кімната: кути проти годинникової стрілки, починаючи з лівого нижнього
стала ШИРИНА = 4
стала ВИСОТА = 3
хай кути = [Точка(0, 0), Точка(ШИРИНА, 0), Точка(ШИРИНА, ВИСОТА), Точка(0, ВИСОТА)]
друкуй("Кути кімнати:", кути)
друкуй("Периметр:", 2 * (ШИРИНА + ВИСОТА), "м, діагональ:", округли(відстань(кути[0], кути[2]), 3), "м")

# Точка на стіні: номер стіни (0 — нижня, 1 — права, 2 — верхня, 3 — ліва)
# і відстань від кута, з якого стіна починається (обхід проти годинникової)
дія точка_на_стіні(стіна, від_кута)
    хай а = кути[стіна]
    хай б = кути[(стіна + 1) % 4]
    хай напрям = (б - а) / відстань(а, б)
    поверни а + напрям * від_кута

# Відстань уздовж периметра від кута 0 (проти годинникової) до точки на стіні
дія по_периметру(стіна, від_кута)
    хай пройдено = 0
    для i у діапазон(стіна)
        пройдено = пройдено + відстань(кути[i], кути[(i + 1) % 4])
    поверни пройдено + від_кута

# Щиток — на лівій стіні, 0.5 м від верхнього кута (стіна 3 іде згори вниз)
хай щиток_стіна = 3
хай щиток_від_кута = 0.5
хай щиток = точка_на_стіні(щиток_стіна, щиток_від_кута)
друкуй("Щиток:", щиток)

# Розетки: назва, стіна, відстань від початку стіни
хай розетки = [
    {"назва": "біля ліжка", "стіна": 0, "від_кута": 1.2},
    {"назва": "телевізор", "стіна": 1, "від_кута": 1.5},
    {"назва": "стіл", "стіна": 2, "від_кута": 0.8},
    {"назва": "двері", "стіна": 3, "від_кута": 2.5}
]

# Кабель іде по стінах: по периметру можна піти в обидва боки — беремо коротший
стала ПЕРИМЕТР = 2 * (ШИРИНА + ВИСОТА)
хай щиток_позиція = по_периметру(щиток_стіна, щиток_від_кута)
хай усього = 0
для р у розетки
    хай точка = точка_на_стіні(р.стіна, р.від_кута)
    хай позиція = по_периметру(р.стіна, р.від_кута)
    хай уздовж = модуль(позиція - щиток_позиція)
    хай по_стінах = мінімум(уздовж, ПЕРИМЕТР - уздовж)
    хай навпростець = відстань(щиток, точка)
    усього = усього + по_стінах
    друкуй(р.назва, "у", точка, "— по стінах", округли(по_стінах, 2), "м, навпростець", округли(навпростець, 2), "м")

# Запас 10% на підключення і повороти
хай із_запасом = округли(усього * 1.1, 1)
друкуй("Усього кабелю по стінах:", округли(усього, 2), "м, із запасом 10%:", із_запасом, "м")

# Трохи «CAD»: розетка на 0.3 м від підлоги — це зсув по осі y для нижньої
# стіни; а розетку біля стола перенесемо, обернувши план на 90° навколо центру
хай центр = середина(кути[0], кути[2])
хай план_обернутий = оберни(кути, 90, центр)
друкуй("Центр:", центр, " план, обернутий на 90°:", план_обернутий)
хай від_щитка_до_стола = перетин_прямих(щиток, точка_на_стіні(2, 0.8), кути[1], кути[2])
друкуй("Промінь щиток→стіл перетинає праву стіну в", від_щитка_до_стола)
хай лампа = Точка(2, 1.5)
друкуй("Відстань від лампи до нижньої стіни:", відстань_до_прямої(лампа, кути[0], кути[1]), "м")
друкуй("Кабель-канал на 0.1 м від нижньої стіни:", паралельна(кути[0], кути[1], 0.1))
друкуй("Де коло радіусом 1.6 м навколо лампи перетинає верхню стіну:", перетин_кола_з_прямою(лампа, 1.6, кути[3], кути[2]))
