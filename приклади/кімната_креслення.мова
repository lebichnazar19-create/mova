# Робочий CAD (версія 1.0): план кімнати з розетками — ескіз із прив'язками
# словами, розв'язувач, потім креслення з розмірами. Одиниці — сантиметри
# на плані. На комп'ютері покажи() відкриє креслення.html; у застосунку з
# програми (кнопка «Зробити застосунок») аркуш видно на полотні.
# Запуск: python3 мова.py --без-пристрою приклади/кімната_креслення.мова

# середина() і Точка — з бібліотеки «геометрія» (з 1.5 її треба підключити)
підключи("геометрія")

# Кути кімнати — грубо, розв'язувач підправить
вузол("пд_зх", 0, 0)
вузол("пд_сх", 390, 5)
вузол("пн_сх", 402, 296)
вузол("пн_зх", 3, 310)
сегмент("південна", "пд_зх", "пд_сх")
сегмент("східна", "пд_сх", "пн_сх")
сегмент("північна", "пн_сх", "пн_зх")
сегмент("західна", "пн_зх", "пд_зх")

# Прив'язки простими словами: прямокутник 400×300
горизонтально("південна")
під_кутом("східна", "південна", 90)
паралельно_до("північна", "південна")
паралельно_до("західна", "східна")
довжина("південна", 400)
довжина("східна", 300)

# Щиток і розетки — на стінах, на заданих відстанях від кутів
вузол("щиток", 0, 250)
на_стіні("щиток", "західна", 50)          # західна йде з пн_зх униз: 50 см від верхнього кута
вузол("р_ліжко", 120, 0)
на_стіні("р_ліжко", "південна", 120)
вузол("р_тв", 400, 150)
на_стіні("р_тв", "східна", 150)
вузол("р_стіл", 300, 300)
на_стіні("р_стіл", "північна", 80)
# Стіл 120×60 біля північної стіни: паралельно стіні, на відстані 10 см
вузол("с1", 150, 280)
вузол("с2", 270, 281)
вузол("с3", 269, 220)
вузол("с4", 151, 221)
сегмент("стіл_верх", "с1", "с2")
сегмент("стіл_прав", "с2", "с3")
сегмент("стіл_низ", "с3", "с4")
сегмент("стіл_лів", "с4", "с1")
паралельно_до("стіл_верх", "північна")
під_кутом("стіл_прав", "стіл_верх", 90)
паралельно_до("стіл_низ", "стіл_верх")
паралельно_до("стіл_лів", "стіл_прав")
довжина("стіл_верх", 120)
довжина("стіл_прав", 60)
на_відстані("с1", "північна", 10)
на_відстані("с2", "північна", 10)
на_відстані("с1", "західна", 150)

розвяжи()

# Точки з ескізу — одразу в геометрію і креслення
хай кути = [вузол("пд_зх"), вузол("пд_сх"), вузол("пн_сх"), вузол("пн_зх")]
хай щиток = вузол("щиток")
друкуй("Кімната:", кути)
друкуй("Щиток:", щиток, " розетки:", вузол("р_ліжко"), вузол("р_тв"), вузол("р_стіл"))

# Довжина кабелю по периметру від щитка до кожної розетки (коротший бік)
стала ПЕРИМЕТР = 1400
дія уздовж_периметра(т)
    # відстань від пд_зх проти годинникової: південна → східна → північна → західна
    хай а = кути[0]
    хай б = кути[1]
    хай в = кути[2]
    хай г = кути[3]
    якщо модуль(т.y - а.y) < 0.01
        поверни т.x - а.x
    якщо модуль(т.x - б.x) < 0.01
        поверни 400 + (т.y - б.y)
    якщо модуль(т.y - в.y) < 0.01
        поверни 700 + (в.x - т.x)
    поверни 1100 + (г.y - т.y)
хай усього = 0
для назва у ["р_ліжко", "р_тв", "р_стіл"]
    хай д = модуль(уздовж_периметра(вузол(назва)) - уздовж_периметра(щиток))
    хай кабель = мінімум(д, ПЕРИМЕТР - д)
    усього = усього + кабель
    друкуй(назва, "— кабелю по стінах:", округли(кабель), "см")
друкуй("Усього кабелю:", округли(усього / 100, 2), "м")

# Креслення: план у см на аркуші А2 (одиниця аркуша = 1 см кімнати, тобто 1:10)
аркуш(594, 420, 1.5)
впиши_в_аркуш(15)
хай план = [вузол("пд_зх"), вузол("пд_сх"), вузол("пн_сх"), вузол("пн_зх")]
контур(план)
контур([вузол("с1"), вузол("с2"), вузол("с3"), вузол("с4")])
розмір(план[0], план[1], -12)
розмір(план[1], план[2], 12)
розмір(вузол("с3"), вузол("с2"), 8)
виноска(вузол("щиток"), "щиток")
виноска(вузол("р_ліжко"), "розетка")
виноска(вузол("р_тв"), "розетка ТВ")
виноска(вузол("р_стіл"), "розетка")
осьова(середина(план[0], план[3]), середина(план[1], план[2]))
штамп("План кімнати 4×3 м", "розетки", "1:10")
друкуй("Креслення готове: покажи() відкриє креслення.html.")
покажи()
