# запитай() — програма питає, ти відповідаєш.
# У застосунку під виводом з'являється рядок вводу з кнопкою «Далі»,
# у консолі відповідь читається з клавіатури.

хай імя = запитай("Як тебе звати?")
друкуй("Привіт, " + імя + "!")

# запитай_число() повторює запитання, поки не введуть число
хай вік = запитай_число("Скільки тобі років?")
друкуй("Через рік тобі буде", вік + 1)

хай загадане = 7
хай спроба = 0
поки спроба != загадане
    спроба = запитай_число("Я загадала число від 1 до 10. Яке?")
    якщо спроба < загадане
        друкуй("Більше!")
    якщо спроба > загадане
        друкуй("Менше!")
друкуй("Так! Це", загадане)
