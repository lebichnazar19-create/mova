# Машинний код (версія 1.2): «швидко дія …» збирає дію в код ARM64.
# Та сама сума від 1 до мільйона — через VM (кілька секунд) і через
# «швидко» (тисячні частки секунди).
# Запуск: python3 мова.py --без-пристрою приклади/швидко.мова

стала Н = 1000000

дія сума_вм(н)
    хай с = 0
    хай к = 1
    поки к <= н
        с = с + к
        к = к + 1
    поверни с

швидко дія сума_швидко(н)
    хай с = 0
    хай к = 1
    поки к <= н
        с = с + к
        к = к + 1
    поверни с

друкуй("Рахую суму 1..", Н)

хай старт = секунди()
хай через_вм = сума_вм(Н)
хай час_вм = секунди() - старт
друкуй("VM:      ", через_вм, "за", округли(час_вм, 3), "с")

старт = секунди()
хай через_код = сума_швидко(Н)
хай час_код = секунди() - старт
друкуй("швидко:  ", через_код, "за", округли(час_код, 3), "с")

якщо через_вм == через_код
    друкуй("Результати однакові.")
якщо час_код > 0
    друкуй("Прискорення приблизно у", округли(час_вм / час_код), "разів")

# Що не вкладається в перший крок — працює через VM із попередженням:
швидко дія половина(а)
    поверни а / 2
друкуй("половина(7) =", половина(7))
