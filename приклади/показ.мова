# Показова програма: облік робочих годин електрика за тиждень.
# Використовує все, що вміє Мова (версія 0.5). Запуск:
#     python3 мова.py --без-пристрою приклади/показ.мова

# Сталі й змінні: ставка, норма годин на день, множник за понаднормові
стала СТАВКА = 250
стала НОРМА = 8
стала МНОЖНИК = 1.5
хай файл_звіту = "показ_години.txt"

# Структура: один робочий день з полями і власними діями («я» — сам день)
тип День
    назва
    години = 0
    дія понаднормові()
        якщо я.години > НОРМА
            поверни я.години - НОРМА
        поверни 0
    дія опис()
        поверни я.назва + ": " + я.години + " год"

# Структура з полями-списками: увесь тиждень із днями та підсумками
тип Тиждень
    електрик
    дні = []
    дія додай_день(день)
        додай(я.дні, день)
    дія усього_годин()
        хай сума = 0
        для д у я.дні
            сума = сума + д.години
        поверни сума

# Функція з умовами і рядками: перевіряє ввід і кидає власну помилку
дія перевір_години(назва, години)
    якщо години < 0
        кинь("у", назва, "від'ємні години:", години)
    якщо години > 16
        кинь("у", назва, "більше 16 годин за день:", години)
    поверни години

# Функція з арифметикою: оплата дня = норма за ставкою + понаднормові з надбавкою
дія оплата_дня(день)
    хай звичайні = день.години - день.понаднормові()
    поверни звичайні * СТАВКА + день.понаднормові() * СТАВКА * МНОЖНИК

# Словник: ввід «день -> години» (у застосунку замість питай() задаємо тут)
хай ввід = словник()
ввід["Понеділок"] = 8
ввід["Вівторок"] = 10
ввід["Середа"] = 7.5
ввід["Четвер"] = 12
ввід["П'ятниця"] = -2
ввід.Субота = 4

# Обробка помилок: неправильні дні пропускаємо, а не падаємо
хай тиждень = Тиждень("Іван Петренко")
хай пропущені = []
для назва у ввід
    спробуй
        хай години = перевір_години(назва, ввід[назва])
        тиждень.додай_день(День(назва, години))
    якщо помилка
        додай(пропущені, назва)
        друкуй("Пропускаю —", помилка)

# Цикли «поки» і «для», перервись/продовж: шукаємо перший день з понаднормовими
хай номер = 0
хай перший_довгий = ніщо
поки номер < довжина(тиждень.дні)
    хай день = тиждень.дні[номер]
    номер = номер + 1
    якщо день.понаднормові() == 0
        продовж
    перший_довгий = день.назва
    перервись

# Списки й порівняння: сортований список годин, максимум і мінімум
хай усі_години = []
для д у тиждень.дні
    додай(усі_години, д.години)
сортуй(усі_години)
хай найменше = усі_години[0]
хай найбільше = усі_години[-1]

# Арифметика: сума годин, понаднормових і оплата за тиждень
хай усього = тиждень.усього_годин()
хай понаднормових = 0
хай оплата = 0
для д у тиждень.дні
    понаднормових = понаднормових + д.понаднормові()
    оплата = оплата + оплата_дня(д)
хай середнє = усього / довжина(тиждень.дні)

# Рядки: складаємо текстовий звіт (індекси, зрізи, конкатенація)
хай звіт = "Звіт: " + тиждень.електрик + "\n"
для д у тиждень.дні
    хай коротко = д.назва[:2]
    хай позначка = ""
    якщо д.понаднормові() > 0
        позначка = "  (+" + д.понаднормові() + " понаднормово)"
    звіт = звіт + "  " + коротко + " — " + д.опис() + позначка + "\n"
звіт = звіт + "Усього: " + усього + " год, понаднормових: " + понаднормових + "\n"
звіт = звіт + "До виплати: " + цілий(оплата) + " грн\n"

# Файли: записуємо звіт, дописуємо рядок, перевіряємо існування, читаємо назад
запиши_файл(файл_звіту, звіт)
допиши_файл(файл_звіту, "Найдовший день: " + найбільше + " год, найкоротший: " + найменше + " год\n")
якщо є_файл(файл_звіту)
    друкуй("Файл", файл_звіту, "записано, читаю назад:")
    друкуй("----------------------------------------")
    друкуй(прочитай_файл(файл_звіту))
    друкуй("----------------------------------------")

# Умови «якщо / інакше якщо / інакше» та логіка «і / або / не»
якщо понаднормових > 8 і не довжина(пропущені) == 0
    друкуй("Тиждень важкий: багато понаднормових і є пропущені дні.")
інакше якщо понаднормових > 8 або усього > 45
    друкуй("Тиждень напружений.")
інакше
    друкуй("Тиждень звичайний.")

# Словник у звіті: середнє, перший довгий день, пропущені (перевірка «у»)
хай підсумок = {"середнє": цілий(середнє * 10) / 10, "перший довгий": перший_довгий}
підсумок.пропущено = пропущені
друкуй("Підсумок:", підсумок)
якщо "П'ятниця" у пропущені
    друкуй("П'ятницю треба ввести ще раз.")

# Телефон: вібрація, сповіщення, тост і озвучення (без пристрою — симуляція)
вібруй(200)
спи(0.2)
вібруй(200)
сповісти("Години за тиждень", "До виплати " + цілий(оплата) + " грн")
тост("Звіт збережено у " + файл_звіту)
скажи("Усього " + усього + " годин")

# Помилка читання неіснуючого файлу теж ловиться, програма живе далі
спробуй
    прочитай_файл("минулий_тиждень.txt")
якщо помилка
    друкуй("Минулого тижня немає:", помилка)
друкуй("Готово.")
