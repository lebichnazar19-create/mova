# Контрольний приклад проєкту (розділ 11 ТЗ):
# читає заряд батареї, і якщо він нижче порогу — вібрує тричі й сповіщає.

стала ПОРІГ = 20

дія попередь_тричі()
    хай раз = 0
    поки раз < 3
        вібруй(300)
        спи(0.3)
        раз = раз + 1

хай інфо = батарея()
хай заряд = інфо["percentage"]

друкуй("Поточний заряд:", заряд, "%")

якщо заряд < ПОРІГ
    сповісти("Розрядка", "Заряд " + заряд + "% — нижче порогу " + ПОРІГ + "%")
    попередь_тричі()
інакше
    друкуй("Заряд у нормі, будильник мовчить.")
