# Ескіз: дві вертикальні стійки однакової довжини, з'єднані зверху
# горизонтальною перемичкою. Початкові координати навмисно неточні —
# розвяжи() сам підправить їх так, щоб усі прив'язки виконались.

вузол("а1", 0, 0)
вузол("а2", 3, 38)
вузол("б1", 47, 2)
вузол("б2", 53, 41)

сегмент("ліва", "а1", "а2")
сегмент("права", "б1", "б2")
сегмент("верх", "а2", "б2")

вертикально("ліва")
вертикально("права")
рівні("ліва", "права")
горизонтально("верх")
довжина("ліва", 40)

розвяжи()

# тепер розв'язані координати можна малювати як завгодно —
# наприклад, через ядро/креслення.py. Але координати розвяжи() — від умов,
# не від аркуша: вони можуть лежати де завгодно (і за рамкою, і під
# штампом). впиши_в_аркуш() зсуває всю геометрію так, щоб її габарити
# лягли в робоче поле з відступом 10 мм — тому викликається після аркуш(),
# але до контур()/розмір(), які читають координати назад.
аркуш(150, 100, 3)
впиши_в_аркуш(10)

друкуй("а1:", вузол("а1"))
друкуй("а2:", вузол("а2"))
друкуй("б1:", вузол("б1"))
друкуй("б2:", вузол("б2"))

контур([вузол("а1"), вузол("а2"), вузол("б2"), вузол("б1")])
розмір(вузол("а1")[0], вузол("а1")[1], вузол("а2")[0], вузол("а2")[1], -10)
штамп("Рама", "Дерево", "1:1")
покажи()
