# Кнопки в програмі (версія 0.9): список імен, «Показати» і «Додати».
# У застосунку кнопки з'являються під виводом, програма чекає натискань
# до «Стоп» або «Очистити вивід». Без пристрою (у консолі) кнопка лише
# друкує «[кнопка Напис]», а програма завершується одразу.
# Запуск: python3 мова.py --без-пристрою приклади/кнопки.мова

хай імена = ["Оля", "Іван"]

дія показати()
    якщо довжина(імена) == 0
        друкуй("Список порожній.")
    інакше
        друкуй("Імена (" + довжина(імена) + "):", з'єднай(імена, ", "))

дія додати()
    хай нове = обріж(питай("Нове ім'я: "))
    якщо нове == ""
        друкуй("Порожнє ім'я не додаю.")
    інакше якщо нове у імена
        друкуй("Таке ім'я вже є:", нове)
    інакше
        додай(імена, нове)
        друкуй("Додано:", нове)

дія очистити()
    імена = []
    друкуй("Список очищено.")

друкуй("Натискай кнопки під виводом.")
кнопка("Показати", показати)
кнопка("Додати", додати)
кнопка("Очистити", очистити)
