# Змінні (хай/стала), усі арифметичні операції
хай а = 7
хай б = 2

друкуй("а + б =", а + б)
друкуй("а - б =", а - б)
друкуй("а * б =", а * б)
друкуй("а / б =", а / б)
друкуй("а % б =", а % б)
друкуй("-а =", -а)

стала ПІ = 3.14
друкуй("стала ПІ =", ПІ)

хай гроші = 100
гроші = гроші - 30
друкуй("гроші після витрати:", гроші)
