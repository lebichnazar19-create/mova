# Типи: поля, типові значення, дії з «я», вкладені типи
тип Точка
    x
    y = 0
    дія зсунь(dx, dy)
        я.x = я.x + dx
        я.y = я.y + dy
    дія опис()
        поверни "(" + я.x + ", " + я.y + ")"

тип Лінія
    початок
    кінець
    дія довжина_по_x()
        поверни я.кінець.x - я.початок.x

хай т = Точка(1, 2)
т.зсунь(3, 3)
т.y = 0
друкуй(т.опис(), т)

хай л = Лінія(Точка(0, 0), Точка(5, 5))
л.кінець.x = 12
друкуй("по x:", л.довжина_по_x())
друкуй(Точка(1, 2) == Точка(1, 2))
