# Перевірка області видимості: дія бачить глобальну змінну на читання,
# але присвоєння всередині дії створює свою локальну копію, а не змінює
# зовнішню (глобальну) змінну.
хай лічильник = 10

дія спробуй_змінити()
    друкуй("Бачу зовні:", лічильник)
    лічильник = 999
    друкуй("Локально стало:", лічильник)

спробуй_змінити()
друкуй("Зовні лишилось:", лічильник)
