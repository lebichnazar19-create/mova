# Обробка помилок: програма не падає, текст помилки — у змінній «помилка»
спробуй
    хай х = число("сім")
    друкуй("сюди не дійде")
якщо помилка
    друкуй("Не вийшло:", помилка)

дія обернене(n)
    спробуй
        поверни 1 / n
    якщо помилка
        поверни "нескінченність (" + помилка + ")"

друкуй(обернене(4), обернене(0))

дія перевір_вік(вік)
    якщо вік < 0
        кинь("вік не може бути від'ємним:", вік)
    поверни вік

спробуй
    перевір_вік(-3)
якщо помилка
    друкуй(помилка)
друкуй("Програма живе далі")
