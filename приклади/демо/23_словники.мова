# Словники: створення, ключі, перевірка наявності, перебір
хай ціни = словник()
ціни["яблуко"] = 12
ціни.груша = 15
хай запаси = {"яблуко": 3, "слива": 0}

якщо "груша" у ціни
    друкуй("груша по", ціни.груша)
якщо "манго" не у ціни
    друкуй("манго немає")

для назва у ціни
    друкуй(назва, "->", ціни[назва])

друкуй("ключі:", ключі(запаси), "усього:", довжина(запаси))
хай було = вилучи(запаси, "слива")
друкуй("вилучили сливу:", було, запаси)
