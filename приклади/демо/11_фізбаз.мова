# Комбінована програма: цикли + умови + дії + списки + рядки разом (FizzBuzz)
дія опиши(n)
    якщо n % 15 == 0
        поверни "ФізБаз"
    інакше якщо n % 3 == 0
        поверни "Фіз"
    інакше якщо n % 5 == 0
        поверни "Баз"
    поверни рядок(n)

хай результати = []
для n у діапазон(1, 16)
    результати = результати + [опиши(n)]

для р у результати
    друкуй(р)
