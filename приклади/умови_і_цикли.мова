# Приклад етапу 2: якщо/інакше/інакше якщо, поки, порівняння, логіка.
# Навмисно без дій, списків і пристрою — лише те, що дає етап 2.

хай оцінка = 73

якщо оцінка >= 90
    друкуй("A")
інакше якщо оцінка >= 70
    друкуй("B")
інакше якщо оцінка >= 50
    друкуй("C")
інакше
    друкуй("F")

хай а = істина
хай б = хиба
друкуй(а і б, а або б, не а)

хай х = 1
поки х <= 5
    якщо х % 2 == 0
        друкуй(х, "парне")
    інакше
        друкуй(х, "непарне")
    х = х + 1
