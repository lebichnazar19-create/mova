# фігури.мова — багаторазові дії для обчислень із геометрії.
# Не самостійна програма: підключається з іншого файлу через
#     підключи "фігури.мова"
# (шлях рахується відносно директорії файлу, що підключає, тому головний.мова
# поруч бачить його просто як "фігури.мова").

стала ПІ = 3.14159

дія площа_квадрата(сторона)
    поверни сторона * сторона

дія периметр_квадрата(сторона)
    поверни сторона * 4

дія площа_кола(радіус)
    поверни ПІ * радіус * радіус
