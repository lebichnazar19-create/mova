# Бібліотека «екран»: коло, яке їде за пальцем.
# Запусти в застосунку «Вуж» і торкнись полотна — коло попливе до пальця.
# Зупинити — кнопка «Стоп». На комп'ютері (без полотна) пальця немає,
# тож коло просто стоїть посередині: python3 вуж.py приклади/палець.вуж

підключи("екран")

хай x = ширина() / 2
хай y = висота() / 2

поки істина
    якщо торкнувся()
        # за кадр проходимо п'яту частину шляху до пальця — рух плавний
        x = x + (палець_х() - x) / 5
        y = y + (палець_у() - y) / 5
        колір("червоний")
    інакше
        колір("синій")
    очисти()
    круг(x, y, 40)
    онови()
    чекай(0.03)
