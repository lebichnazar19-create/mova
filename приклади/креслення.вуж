# Проста деталь: прямокутник з отвором, три розміри, штамп.
# Заразом показує теми, роботу з видами (вид) і 3D-лінії: проста коробка
# описана лінія3д() один раз і показана в трьох видах та в ізометрії.

аркуш(297, 210, 3, "папір")

хай ш = 80
хай в = 50

хай прямокутник = [[0, 0], [80, 0], [80, 50], [0, 50]]
хай отвір = [[50.0, 25.0], [49.24, 28.83], [47.07, 32.07], [43.83, 34.24], [40.0, 35.0], [36.17, 34.24], [32.93, 32.07], [30.76, 28.83], [30.0, 25.0], [30.76, 21.17], [32.93, 17.93], [36.17, 15.76], [40.0, 15.0], [43.83, 15.76], [47.07, 17.93], [49.24, 21.17]]

# --- основна деталь: вид згори з отвором і трьома розмірами ---
вид("зверху", 30, 145)
контур(прямокутник)
контур(отвір)
розмір(0, 0, ш, 0, -15)
розмір(0, 0, 0, в, 15)
розмір_діаметр(40, 25, 10)
виноска(40, 25, "Отвір наскрізний")

# та сама пластина з торця (той самий контур, інший вид) — товщина 8 мм
вид("спереду", 30, 110)
контур([[0, 0], [ш, 0], [ш, 8], [0, 8]])
осьова(-5, 4, ш + 5, 4)

штамп("Пластина кріпильна", "Сталь 3", "1:1")

# --- окремо: проста 3D-коробка, описана раз і показана в 3 видах + ізометрія ---
лінія3д([[0, 0, 0], [20, 0, 0], [20, 12, 0], [0, 12, 0], [0, 0, 0]])
лінія3д([[0, 0, 10], [20, 0, 10], [20, 12, 10], [0, 12, 10], [0, 0, 10]])
лінія3д([[0, 0, 0], [0, 0, 10]])
лінія3д([[20, 0, 0], [20, 0, 10]])
лінія3д([[20, 12, 0], [20, 12, 10]])
лінія3д([[0, 12, 0], [0, 12, 10]])

